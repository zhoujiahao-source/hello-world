# App root — set by start.sh automatically
APP_ROOT=

# Where portable data is stored (defaults to APP_ROOT/portable-data)
APP_DATA_DIR=

# Server port
APP_PORT=4000

# Frontend dev port
VITE_PORT=5173

# API base URL (used by frontend)
VITE_API_BASE_URL=http://localhost:4000

# Engine API keys (stored securely in portable-data/state, not here)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
